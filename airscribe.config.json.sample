{
  "host": "127.0.0.1",
  "port": 8100,
  "dataDir": "./data",

  "_adminPort": "Set this and the public surface moves to `port` while radios, settings and downloads stay on adminPort. Bind adminHost to 127.0.0.1 and the admin surface is unreachable rather than merely guarded.",
  "adminPort": null,
  "adminHost": "127.0.0.1",

  "auth": {
    "username": null,
    "passwordHash": null,
    "tokens": []
  },

  "sidecar": {
    "python": "python3",
    "backend": "bluez",
    "controlChannel": null,
    "audioChannel": null
  },

  "_publish": "Nothing is published until enabled is true AND a radio is marked public. delayMinutes holds transmissions back from the public surface; the admin port always shows them live.",
  "publish": {
    "enabled": false,
    "transcripts": true,
    "audio": false,
    "feed": true,
    "delayMinutes": 30
  },

  "reconnect": {
    "baseMs": 5000,
    "maxMs": 300000
  },

  "audio": {
    "sampleRate": 32000,
    "preRollMs": 300,
    "holdMs": 1200,
    "minMs": 400,
    "maxMs": 120000,
    "overlapMs": 300,
    "energyThreshold": 0.02
  },

  "stt": {
    "engines": {
      "base": {
        "type": "sherpa-onnx",
        "python": "python3",
        "model": "whisper-base.en",
        "modelDir": "/EDIT-ME/models/sherpa-onnx-whisper-base.en",
        "language": "en"
      },
      "tiny": {
        "type": "sherpa-onnx",
        "python": "python3",
        "model": "whisper-tiny.en",
        "modelDir": "/EDIT-ME/models/sherpa-onnx-whisper-tiny.en",
        "language": "en"
      }
    },
    "default": "base",
    "alsoRun": []
  }
}
