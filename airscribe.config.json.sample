{
  "host": "127.0.0.1",
  "port": 8100,
  "dataDir": "./data",

  "auth": {
    "tokens": []
  },

  "sidecar": {
    "python": "python3",
    "backend": "bluez",
    "controlChannel": null,
    "audioChannel": null
  },

  "reconnect": {
    "baseMs": 5000,
    "maxMs": 300000
  },

  "audio": {
    "sampleRate": 32000,
    "preRollMs": 300,
    "holdMs": 1200,
    "minMs": 400,
    "maxMs": 120000,
    "overlapMs": 300,
    "energyThreshold": 0.02
  },

  "stt": {
    "engines": {
      "base": {
        "type": "sherpa-onnx",
        "python": "python3",
        "model": "whisper-base.en",
        "modelDir": "/EDIT-ME/models/sherpa-onnx-whisper-base.en",
        "language": "en"
      },
      "tiny": {
        "type": "sherpa-onnx",
        "python": "python3",
        "model": "whisper-tiny.en",
        "modelDir": "/EDIT-ME/models/sherpa-onnx-whisper-tiny.en",
        "language": "en"
      }
    },
    "default": "base",
    "alsoRun": []
  }
}
