{
  "host": "127.0.0.1",
  "port": 8100,
  "dataDir": "./data",

  "_adminPort": "Set this and the public surface moves to `port` while radios, settings and downloads stay on adminPort. Bind adminHost to 127.0.0.1 and the admin surface is unreachable rather than merely guarded.",
  "adminPort": null,
  "adminHost": "127.0.0.1",

  "auth": {
    "username": null,
    "passwordHash": null,
    "tokens": []
  },

  "_sidecar": "backend: bluez (the host's Bluetooth), bumble (a USB dongle driven directly: an LXC container or Windows; python must then be a Python 3.11+ with Bumble, and transport names the dongle, usb:0 or usb:VID:PID), or sim. See docs/bluetooth.md.",
  "sidecar": {
    "python": "python3",
    "backend": "bluez",
    "transport": "usb:0",
    "controlChannel": null,
    "audioChannel": null
  },

  "_map": "The Map view's base maps, MapLibre style URLs; the first marked dark is the default in a dark browser. Leave this out for these three.",
  "map": {
    "styles": [
      { "name": "Color relief", "url": "https://tiles.wifidb.net/styles/WDB_COLOR_RELIEF/style.json" },
      { "name": "Color relief (dark)", "url": "https://tiles.wifidb.net/styles/WDB_COLOR_RELIEF_DARK/style.json", "dark": true },
      { "name": "OpenStreetMap", "url": "https://tiles.wifidb.net/styles/WDB_OSM/style.json" }
    ]
  },

  "_radioreference": "Map → Find looks a channel's frequency up in RadioReference. The account (it needs Premium) and ZIP code are set in Admin → RadioReference; an appKey here is used when none is set there. See docs/radioreference.md.",
  "radioreference": {
    "appKey": null
  },

  "_publish": "Nothing is published until enabled is true AND a radio is marked public. delayMinutes holds transmissions back from the public surface; the admin port always shows them live.",
  "publish": {
    "enabled": false,
    "transcripts": true,
    "audio": false,
    "feed": true,
    "delayMinutes": 30
  },

  "reconnect": {
    "baseMs": 5000,
    "maxMs": 300000
  },

  "audio": {
    "sampleRate": 32000,
    "preRollMs": 300,
    "holdMs": 1200,
    "minMs": 400,
    "maxMs": 120000,
    "overlapMs": 300,
    "energyThreshold": 0.02
  },

  "stt": {
    "engines": {
      "base": {
        "type": "sherpa-onnx",
        "python": "python3",
        "model": "whisper-base.en",
        "modelDir": "/EDIT-ME/models/sherpa-onnx-whisper-base.en",
        "language": "en"
      },
      "tiny": {
        "type": "sherpa-onnx",
        "python": "python3",
        "model": "whisper-tiny.en",
        "modelDir": "/EDIT-ME/models/sherpa-onnx-whisper-tiny.en",
        "language": "en"
      }
    },
    "default": "base",
    "alsoRun": []
  }
}
