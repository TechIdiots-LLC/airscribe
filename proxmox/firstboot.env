# Settings for the container's first boot (airscribe-firstboot), applied to /etc/airscribe/airscribe.config.json.
# Uncomment and set before starting the container (pct mount, or edit and run airscribe-firstboot again), or change
# airscribe.config.json itself later. See docs/proxmox.md.

# The port AirScribe listens on, on every address of the container
#AIRSCRIBE_PORT=8100

# The sign-in password (8 characters or more). Left unset, the first boot makes one and writes it to
# /root/airscribe-first-login.txt; a password already in the settings is kept.
#AIRSCRIBE_PASSWORD=
